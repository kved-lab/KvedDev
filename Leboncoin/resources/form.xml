	        if (availability_ds_str != '' || availability_de_str != '') {
			var parentNode = availability_ds_field.parentNode.parentNode.id;

	                if (availability_ds_str != '' && availability_de_str == '') {
				display_warning(parentNode, "Les p&eacute;riodes et ou tarifs que vous avez remplies ne sont pas valides.");
