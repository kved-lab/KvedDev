		        }
	        }
	}

	
	var _subtypes = document.getElementById('subtypes');
	if( _subtypes && _subtypes.style.display == 'none') {
		var st = document.getElementsByName('st');
	        for( i = 0; st && i < st.length; i++) {
st[i].disabled = true;
			st[i].checked = false;

		}
	}

	if(error) {
		return !error;
	}

	return construct_friendly_url(zz_in, location_in);
	
