function zipcode_check() {
    unshow_warning();

    var zz_in = document.getElementById("zipcoded");
	if (zz_in.value.length != 0) {
		var matched = zz_in.value.match(/[0-9]/g);
		if (matched == undefined) {
			zz_in.value = "";
			display_warning('zipcode', "Votre code postal est incorrect.");
		} else {
		zz_in.value = matched.join('');
		if (zz_in.value != zz_in.value.match(/^[0-9]{5}$/)) {
			display_warning('zipcode', "Votre code postal est incomplet");
		}
		}
	}
}

function perform_search() {
	unshow_warning();
    document.cookie = "is_new_search=1; expdate=; domain=.leboncoin.fr; path=/";
	var error = false;

	// First: remove white space from zipcode
	var zz_in = document.getElementById("zipcoded");
	if( zz_in.value.length > 1 && zz_in.value.charAt(0) == 'e' && 
			zz_in.value.charAt(1) == 'x') {
		zz_in.value = "";
	} else { 
		var zz_clean = zz_in.value.replace(/ /g,"");
		zz_in.value = zz_clean;

		if(zz_in.value.length > 0 && zz_in.value.length < 5) {
			display_warning('zipcode', "Votre code postal est incomplet");
			error = true;
		} else if(zz_in.value.length > 5) {
			display_warning('zipcode', "Votre code postal est incorrect.");
			error = true;
		} else if (zz_in.value.length > 0) {
			for(i=0; i < 5; ++i) {
				if(!RegExp('^[0-9]+$','g').test(zz_in.value.charAt(i))) {
					display_warning('zipcode', "Votre code postal est incomplet");
					error = true;
					break;
				}
			}
		}
	}

	var location_in = document.getElementById("location");
    if( location_in.value == 'Ville ou code postal' ) {
        location_in.value = '';
    }
    if(location_in.value != '') {
        location_in.value = location_in.value.replace(new RegExp('&','g'), "");
    }

	
	// Uncheck search in title if q is empty
	var ctitle_in = document.getElementById("ctitle");
	var searchtext_in = document.getElementById("searchtext");
	if(ctitle_in && ctitle_in.checked == 1 && searchtext_in.value == "") {
		ctitle_in.checked = 0;
	}
	

	
	var fields = getElementsByClassName(document.getElementById('searchextras'),
			'div', 'featurebox');

	for(i=0; i < fields.length; i++) {

		var select = fields[i].getElementsByTagName('select');
		var len = select.length;

		if(len == 2) {
			if(select[0].selectedIndex == 0 || select[1].selectedIndex == 0) {
				continue;
			}

			var parentNode = select[0].parentNode.parentNode.id;

			var min = select[0].options[select[0].selectedIndex].text.replace(/\s/g, '');
			var max = select[1].options[select[1].selectedIndex].text.replace(/\s/g, '');
			
			if(parseInt(min) > parseInt(max)) {
				display_warning(parentNode, "Le minimum est sup&eacute;rieur au maximum");
				error = true;
			}
		}
	}

	
	var availability_ds_field = document.getElementById('availability_ds');
	var availability_de_field = document.getElementById('availability_de');

	if (typeof(availability_ds_field) != "undefined" && 
