				display_warning(parentNode, "Les p&eacute;riodes et ou tarifs que vous avez remplies ne sont pas valides.");
				error = true;
	                } else if (availability_ds_int > availability_de_int) {
				display_warning(parentNode, "Les p&eacute;riodes et ou tarifs que vous avez remplies ne sont pas valides.");
				error = true;
			} else if (availability_ds_int > availability_de_int - 1) {
				display_warning(parentNode, "Les p&eacute;riodes et ou tarifs que vous avez remplies ne sont pas valides.");
